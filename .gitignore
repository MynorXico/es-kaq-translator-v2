# Dependencies
node_modules/
.pnpm-store/
__pycache__/
*.pyc
.venv/
venv/

# Build outputs
dist/
# Per-environment apps/web Vite build outputs (issue #263) -- lib/
# pipeline-stack.ts's synth step builds apps/web once per dev/qa/prod, each
# into its own dist-<env>/ directory (see lib/config.ts's
# webBuildOutputDirName), so a plain `dist/` entry above doesn't cover them.
dist-dev/
dist-qa/
dist-prod/
build/
*.egg-info/
cdk.out/

# Test artifacts
playwright-report/
test-results/
.pytest_cache/

# Environment / secrets
.env
.env.*
!.env.example

# ML artifacts (large files, never commit raw data or trained weights)
ml/data/raw/
ml/data/**/*.csv
ml/data/**/*.tsv
ml/data/**/*.parquet
*.ckpt
*.pt
*.bin
*.safetensors

# Editor / OS
.vscode/
.idea/
.DS_Store

# Logs
*.log
npm-debug.log*
